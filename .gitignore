# Datasets and indexes
pdbbind/

# AF3 outputs, relaxed PDBs, Rosetta score files
*.pdb
*.cif
*.sc
*.log
dockq_results/

# Generated CSV outputs
*.csv

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Jupyter notebooks cache
.ipynb_checkpoints/

# macOS
.DS_Store

# Rosetta installation folder
rosetta*/

# Keep scripts/ tracked (not ignored)

# Benchmark tables and sequence-derived AF3 job inputs (PDBBind-derived;
# regenerate with scripts/select_complexes.py and scripts/prepare_bench20_af3.py)
/comp_list
/clone_list
/bench20/*.tsv
/alphafold3_server/jobs/
/alphafold3_server/*.fasta
/alphafold3_server/*_chain_mapping.tsv

# AF3 Server downloads (archives, extracted outputs, confidence JSONs)
/alphafold3_server/predictions/*
!/alphafold3_server/predictions/.gitkeep

# Phase B working directory (relaxed models, PLIP output, parser tables)
/bench20/work/

# Archived pilot10 and superseded Phase A drafts; keep only the notes
/archive/**
!/archive/**/
!/archive/**/*.md

# Physchem tier-1 track: small, reviewable inputs and outputs are tracked
# (overrides the blanket *.csv rule above)
!/data/*.csv

# Immutable run directories: the result history. Text-sized only; large
# artefacts are recorded by path and hash, never stored here. Exempted from
# the blanket *.csv rule so run outputs are not silently dropped.
!/runs/**/*.csv

# Quarto: the rendered site is disposable, the freeze cache is not. Keeping
# docs/_freeze/ is what stops previously rendered pages re-executing and
# changing old results.
/docs/_site/
/docs/.quarto/
